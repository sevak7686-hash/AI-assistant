TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=google/gemini-2.5-flash
# Optional override; otherwise the OpenRouter chat key above is reused for transcription.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=ru
# Comma-separated Telegram user IDs. Required; the bot rejects all users when empty.
ALLOWED_TELEGRAM_USER_IDS=
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant_dev_password
DATABASE_URL=postgresql+asyncpg://assistant:assistant_dev_password@localhost:5433/assistant
