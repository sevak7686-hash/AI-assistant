TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=openai/gpt-4o
# Optional proxy used for Telegram traffic only, for example:
TELEGRAM_PROXY_URL=
SERPAPI_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=35
MAX_TOOL_ROUNDS=2
# Optional; enables Russian voice/audio transcription through the OpenAI API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
REMINDER_TIMEZONE=Europe/Moscow
# Comma-separated Telegram user IDs. Leave empty only for local testing.
ALLOWED_TELEGRAM_USER_IDS=536559162, 1304127999
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant_dev_password
