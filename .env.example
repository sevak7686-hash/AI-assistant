TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=openai/gpt-4o
DEEPSEEK_MAX_TOKENS=512
# Optional Telegram-only proxy. Use socks5:// for a real SOCKS proxy, or
# http:// for an HTTP proxy such as Squid (port 3128 is commonly HTTP).
TELEGRAM_PROXY_URL=
# Search and reminder settings used by the corresponding features.
SERPAPI_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=35
MAX_TOOL_ROUNDS=2
# Optional transcription settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=ru
REMINDER_TIMEZONE=Europe/Moscow
ALLOWED_TELEGRAM_USER_IDS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# For verify-full/verify-ca, set sslrootcert to the CA path inside the container.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db.example.com:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/provider-ca.pem